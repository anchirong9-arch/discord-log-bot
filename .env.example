# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채워 주세요.
# (실행하기.bat 을 실행하면 자동으로 만들어 줍니다.)

# 1) 봇 토큰 (디스코드 개발자 포털 → Bot → 토큰 초기화)
DISCORD_TOKEN=여기에_봇_토큰을_붙여넣으세요

# 2) 로그를 남길 채널 ID (백수톡 서버의 #서버-로그)
LOG_CHANNEL_ID=1572390727042727976

# 3) (선택) 로그를 디엠으로도 받을 사용자 ID. 비워 두면 디엠은 보내지 않습니다.
#    비공개 채널이라도 서버 관리자 권한이 있는 사람은 볼 수 있기 때문에,
#    나만 보고 싶으면 여기에 본인 디스코드 사용자 ID를 넣으세요.
LOG_USER_ID=
